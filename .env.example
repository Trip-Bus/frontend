# Copia este archivo como .env.local (ya está en .gitignore) y ajusta lo que necesites.

# --- Desarrollo (npm run dev): a dónde manda Vite el proxy ---
# API Gateway levantado con docker compose en el repo API-gateway
DEV_API_TARGET=http://localhost:18000
DEV_WS_TARGET=ws://localhost:18000

# --- Opcional: saltarse el proxy y llamar directo (requiere CORS en el gateway) ---
# VITE_API_URL=http://localhost:18000/api/v1
# VITE_WS_URL=ws://localhost:18000/ws
