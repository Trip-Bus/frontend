# =============================================================================
#  TripBus — Frontend (NGINX)
#  Sirve la app (SPA) y hace de proxy en el MISMO origen:
#    /api/*  → API Gateway (sin el prefijo /api)   ⇒ el navegador no necesita CORS
#    /ws     → Realtime Gateway (WebSocket)
#  Las variables ${...} se reemplazan al iniciar el contenedor (envsubst de la imagen oficial).
# =============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${FRONTEND_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # ---- API REST → API Gateway -----------------------------------------------------
    location /api/ {
        proxy_pass ${API_GATEWAY_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout    35s;
    }

    # ---- Tiempo real → Realtime Gateway ---------------------------------------------
    location = /ws {
        proxy_pass ${REALTIME_URL}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # El gateway manda ping cada 20 s y corta a los 45 s: NGINX no debe cortar antes.
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    location = /salud {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # ---- Archivos con hash: caché de un año ----------------------------------------
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ---- index.html nunca se cachea (así cada despliegue llega al instante) ---------
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # ---- SPA: cualquier ruta de la app devuelve index.html ---------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
